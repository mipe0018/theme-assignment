---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

import { getTeamMembers } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import ArrowLeft from "@icons/arrow-left.svg";

/* ========================================
   IKONER
======================================== */

const iconFiles = import.meta.glob("../../icons/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});

const instagramIcon = iconFiles["../../icons/instagram.svg"];
const facebookIcon = iconFiles["../../icons/facebook.svg"];

export async function getStaticPaths() {
  0;
  // Henter alle teammedlemmer fra API'et
  const team = await getTeamMembers();

  // Opretter en dynamisk side for hver medarbejder
  return team.map((employee: any) => ({
    params: {
      slug: employee.slug,
    },

    props: {
      employee: employee,
    },
  }));
}

// Henter medarbejderen fra props
const { employee }: { employee: any } = Astro.props;
---

<Layout>
  <main class="team-page">
    <!-- Tilbage til team-siden -->

    <a
      href="/team"
      class="back-link"
    >
      <ArrowLeft class="arrow" /> Back to team
    </a>

    <!-- Hovedindhold -->
    <section class="team-detail">
      <!-- Billede -->
      <div class="team-image">
        <div class="green-box"></div>
        <Image
          src={employee.image.src}
          alt={employee.image.alt}
          width={employee.image.width}
          height={employee.image.height}
          transition:name={`team-image-${employee.slug}`}
        />
        <div class="social-icons">
          {
            instagramIcon && (
              <img
                src={instagramIcon}
                alt="Instagram"
              />
            )
          }

          {
            facebookIcon && (
              <img
                src={facebookIcon}
                alt="Facebook"
              />
            )
          }
        </div>
      </div>

      <!-- Information -->
      <div class="team-info">
        <!-- Jobtitel -->
        <p class="eyebrow">
          {employee.title}
        </p>

        <!-- Navn -->
        <h1>
          {employee.name}
        </h1>

        <!-- Kort beskrivelse -->
        <p class="intro">
          {employee.description}
        </p>

        <!-- Lang beskrivelse -->
        <div class="info-section">
          <h2>
            About {employee.name}
          </h2>

          <p>
            {employee.description_long}
          </p>
        </div>

        <!-- Tidligere erfaring -->
        <div class="info-section">
          <h2>Past Experience</h2>

          <p>
            {employee.past_experience}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hele siden */
  .team-page {
    width: 100%;
    max-width: 75rem;
    margin: 0 auto;
    padding: 2rem 2rem 5rem;
  }

  /* Tilbage-link */

  .back-link {
    display: flex;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-blue-700);
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease;
    gap: 1rem;
    line-height: 1;
  }

  .arrow {
    width: 1rem;
    height: 1rem;
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  /* Hovedlayout */
  .team-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  /* Venstre side */
  .team-info {
    padding: 2rem 0;
  }

  /* Jobtitel */
  .eyebrow {
    font: var(--body-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  /* Navn */
  .team-info h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    font-size: 1.8rem;
    font: var(--heading-lg);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  /* Kort beskrivelse */
  .intro {
    min-width: 600px;
    margin: 0 0 3rem;
    line-height: 1.6;
    font: var(--body-lg);
    color: var(--color-text-muted);
  }

  /* Sektioner */
  .info-section {
    margin-top: 2rem;
  }

  .info-section h2 {
    margin-bottom: 0.75rem;
    font-size: 1.8rem;
    font: var(--heading-lg);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .info-section p {
    min-width: 550px;
    line-height: 1.6;
    font: var(--body-lg);
    color: var(--color-text-muted);
  }

  /* Højre side */
  .team-image {
    width: 80%;
    height: 80%;
    overflow: visible;
    border-radius: 30px;
    position: relative;
  }

  /* Selve billedet */
  .team-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  /* Lille zoom når man holder musen over */
  .team-image:hover img {
    transform: scale(1.03);
  }

  .green-box {
    position: absolute;
    width: 15rem;
    height: 10rem;
    top: -2rem;
    left: -2rem;
    background-color: var(--color-green-400);
    z-index: 0;
    border-radius: 25px;
  }

  /* ========================================
   SOCIAL ICONS
======================================== */

  .social-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }

  .social-icons img {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    transition: transform 0.2s ease;
    opacity: 0.8;
    margin-top: 2rem;
  }

  .social-icons img:hover {
    transform: scale(1.1);
  }

  /* -------------------- */
  /* TABLET */
  /* -------------------- */

  @media (max-width: 900px) {
    .team-page {
      padding: 2rem 3rem 5rem;
    }

    .team-detail {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .team-image {
      order: -1;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 1 / 1;
    }

    .team-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .team-info {
      padding: 0;
    }

    .intro {
      min-width: 0;
      margin-bottom: 2.5rem;
    }

    .info-section p {
      min-width: 0;
    }

    .green-box {
      width: 10rem;
      height: 7rem;
      top: -1rem;
      left: -1rem;
      border-radius: 20px;
    }

    .social-icons {
      gap: 1rem;
      padding: 0.75rem 0;
    }

    .social-icons img {
      width: 3rem;
      height: 3rem;
      margin-top: 1rem;
    }
  }

  /* -------------------- */
  /* MOBIL */
  /* -------------------- */

  @media (max-width: 600px) {
    .team-page {
      width: 100%;
      box-sizing: border-box;
      padding: 1.5rem 1.25rem 4rem;
    }

    .back-link {
      margin-top: 1rem;
      margin-bottom: 2rem;
    }

    .team-detail {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .team-image {
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 1 / 1;
      border-radius: 20px;
    }

    .team-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .green-box {
      width: 7rem;
      height: 5rem;
      top: -0.75rem;
      left: -0.75rem;
      border-radius: 18px;
    }

    .team-info {
      width: 100%;
      padding: 0;
    }

    .eyebrow {
      margin-bottom: 0.5rem;
      font-size: 0.85rem;
    }

    .team-info h1 {
      font-size: 2.7rem;
      line-height: 1.05;
      margin-bottom: 0.75rem;
    }

    .intro {
      min-width: 0;
      width: 100%;
      margin-bottom: 2.5rem;
      font-size: 1rem;
      line-height: 1.6;
    }

    .info-section {
      margin-top: 2rem;
    }

    .info-section h2 {
      margin-bottom: 0.75rem;
    }

    .info-section p {
      min-width: 0;
      width: 100%;
      font-size: 1rem;
      line-height: 1.6;
    }

    .social-icons {
      gap: 0.75rem;
      padding: 0.5rem 0;
    }

    .social-icons img {
      width: 2.5rem;
      height: 2.5rem;
      margin-top: 0.5rem;
    }
  }
</style>
