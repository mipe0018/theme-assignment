---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

import { getTeamMembers } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  // Henter alle teammedlemmer fra API'et
  const team = await getTeamMembers();

  // Opretter en dynamisk side for hver medarbejder
  return team.map((employee: any) => ({
    params: {
      slug: employee.slug,
    },

    props: {
      employee: employee,
    },
  }));
}

// Henter medarbejderen fra props
const { employee }: { employee: any } = Astro.props;
---

<Layout>
  <main class="team-page">
    <!-- Tilbage til team-siden -->
    <a
      href="/team"
      class="back-link"
    >
      ← Back to team
    </a>

    <!-- Hovedindhold -->
    <section class="team-detail">
      <!-- Billede -->
      <div class="team-image">
        <Image
          src={employee.image.src}
          alt={employee.image.alt}
          width={employee.image.width}
          height={employee.image.height}
          transition:name={`team-image-${employee.slug}`}
        />
      </div>

      <!-- Information -->
      <div class="team-info">
        <!-- Jobtitel -->
        <p class="eyebrow">
          {employee.title}
        </p>

        <!-- Navn -->
        <h1>
          {employee.name}
        </h1>

        <!-- Kort beskrivelse -->
        <p class="intro">
          {employee.description}
        </p>

        <!-- Lang beskrivelse -->
        <div class="info-section">
          <h2>
            About {employee.name}
          </h2>

          <p>
            {employee.description_long}
          </p>
        </div>

        <!-- Tidligere erfaring -->
        <div class="info-section">
          <h2>Past Experience</h2>

          <p>
            {employee.past_experience}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hele siden */
  .team-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 2rem 5rem;
  }

  /* Tilbage-link */
  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    color: var(--color-blue-700);
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  /* Hovedlayout */
  .team-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* Venstre side */
  .team-info {
    padding: 2rem 0;
  }

  /* Jobtitel */
  .eyebrow {
    font: var(--body-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  /* Navn */
  .team-info h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
  }

  /* Kort beskrivelse */
  .intro {
    max-width: 550px;
    margin: 0 0 3rem;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  /* Sektioner */
  .info-section {
    margin-top: 2rem;
  }

  .info-section h2 {
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }

  .info-section p {
    max-width: 550px;
    line-height: 1.7;
  }

  /* Højre side */
  .team-image {
    width: 100%;
    height: 100%;
    min-height: 600px;
    overflow: hidden;
    border-radius: 30px;
  }

  /* Selve billedet */
  .team-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  /* Lille zoom når man holder musen over */
  .team-image:hover img {
    transform: scale(1.03);
  }

  /* -------------------- */
  /* TABLET */
  /* -------------------- */

  @media (max-width: 900px) {
    .team-detail {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .team-image {
      min-height: 500px;
      order: -1;
    }
  }

  /* -------------------- */
  /* MOBIL */
  /* -------------------- */

  @media (max-width: 600px) {
    .team-page {
      padding: 1.5rem 1.25rem 4rem;
    }

    .back-link {
      margin-bottom: 2rem;
    }

    .team-detail {
      gap: 2rem;
    }

    .team-image {
      min-height: 400px;
      border-radius: 20px;
    }

    .team-info h1 {
      font-size: 2.7rem;
    }

    .intro {
      font-size: 1.05rem;
    }
  }
</style>
