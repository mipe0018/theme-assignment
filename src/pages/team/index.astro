---
import Layout from "@layouts/Layout.astro";
import Teams from "@components/Teams.astro";
---

<Layout>
  <div class="team">
    <div class="team-heading">
      <h2>Team</h2>
      <h1>The Consultors</h1>
      <p>
        Our success stems from the synergy between dedicated teams and our
        valued clients. We prioritize a company culture that fosters exceptional
        productivity, ensures customer satisfaction.
      </p>
    </div>
  </div>
  <Teams />
</Layout>

<style>
  .team {
    grid-column: a / d;
    width: 100%;
    margin-top: 2rem;
  }

  /* Begrænser indholdet til maks. 1200px */
  .team-heading {
    width: min(35rem, 100%);
    margin-inline: auto;
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2rem;
  }
  .team-heading h2 {
    font: var(--body-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .team-heading h1 {
    font-size: 1.8rem;
    font: var(--heading-lg);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .team-heading p {
    line-height: 1.6;
    font: var(--body-lg);
    color: var(--color-text-muted);
  }
</style>
