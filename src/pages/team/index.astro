---
import Layout from "@layouts/Layout.astro";
import Teams from "@components/Teams.astro";
---

<Layout>
  <div class="team">
    <div class="team-heading">
      <h2>Team</h2>
      <h1>The Consultors</h1>
      <p>
        Our success stems from the synergy between dedicated teams and our
        valued clients. We prioritize a company culture that fosters exceptional
        productivity, ensures customer satisfaction.
      </p>
    </div>
  </div>
  <Teams />
</Layout>

<style>
  /* =========================
     TEAM HEADING
     ========================= */

  .team {
    width: 100%;
  }

  .team-heading {
    width: min(75rem, calc(100% - 4rem));
    margin: 4rem auto 3rem;
    text-align: center;
  }

  .team-heading h2 {
    margin-bottom: 1rem;
    font: var(--body-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text);
  }

  .team-heading h1 {
    margin: 0 0 1rem;
    font: var(--heading-lg);
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .team-heading p {
    max-width: 600px;
    margin: 1.25rem auto 0;
    font: var(--body-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 768px) {
    .team {
      width: 100%;
    }

    .team-heading {
      width: calc(100% - 3rem);
      margin: 2.5rem auto 2rem;
      text-align: center;
    }

    .team-heading h2 {
      margin-bottom: 0.5rem;
      font: var(--body-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .team-heading h1 {
      margin: 0 0 0.75rem;
      font: var(--heading-xl);
      font-size: 2.8rem;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .team-heading p {
      max-width: 450px;
      margin: 0 auto;
      font: var(--body-lg);
      font-size: 1rem;
      line-height: 1.5;
    }
  }
</style>
