---
import { Image } from "astro:assets";

// Billeder
import ContactImgOne from "@assets/images/contactimg1.png";
import ContactImgTwo from "@assets/images/contactimg2.png";
import ContactImgThree from "@assets/images/contactimg3.png";

// Ikoner
import IconPhone from "../icons/phone.svg";
import IconClock from "../icons/clock.svg";
import IconPin from "../icons/pin.svg";
---

<section
    class="contact-info"
    id="contact"
>
    <div class="contact-info-inner">
        <!-- TEKST / VENSTRE KOLONNE -->
        <div class="info-text">
            <h2>Process</h2>

            <h1>Contact Us. It’s Easy.</h1>

            <p>
                Leverage agile frameworks to provide a robust synopsis for high
                level overviews. Iterative approaches to corporate strategy
                foster collaborative.
            </p>

            <!-- Telefon -->
            <div class="info-icon">
                <div class="icon-circle phone-circle">
                    <Image
                        class="contact-icon"
                        src={IconPhone}
                        alt="Phone"
                    />
                </div>

                <div class="icon-text">
                    <h2>Call Today</h2>
                    <h3>+1 800 100 900</h3>
                </div>
            </div>

            <!-- Åbningstider -->
            <div class="info-icon">
                <div class="icon-circle clock-circle">
                    <Image
                        class="contact-icon"
                        src={IconClock}
                        alt="Clock"
                    />
                </div>

                <div class="icon-text">
                    <h2>Monday To Friday</h2>
                    <h3>9AM - 5PM</h3>
                </div>
            </div>

            <!-- Adresse -->
            <div class="info-icon">
                <div class="icon-circle pin-circle">
                    <Image
                        class="contact-icon"
                        src={IconPin}
                        alt="Location"
                    />
                </div>

                <div class="icon-text">
                    <h2>USA Office</h2>
                    <h3>195 Devonshire St Boston, MA 02110</h3>
                </div>
            </div>
        </div>

        <!-- STORT BILLEDE / MIDTERSTE KOLONNE -->
        <div class="ContactImgLarge">
            <!-- Grøn boks bag billedet -->
            <div class="green-box"></div>

            <Image
                class="contact-img"
                src={ContactImgOne}
                alt="Contact"
            />
        </div>

        <!-- LILLE BILLEDE ØVERST / HØJRE KOLONNE -->
        <div class="ContactImgSmallTop">
            <Image
                class="contact-img"
                src={ContactImgTwo}
                alt="Contact"
            />
        </div>

        <!-- LILLE BILLEDE NEDERST / HØJRE KOLONNE -->
        <div class="ContactImgSmallBottom">
            <Image
                class="contact-img"
                src={ContactImgThree}
                alt="Contact"
            />
        </div>
    </div>
</section>

<style>
    @layer components {
        /* ========================================
           SELVE SEKTIONEN
           ======================================== */

        .contact-info {
            width: 100%;
            margin-top: 10rem;
        }

        /* ========================================
           1200PX GRID
           ======================================== */

        .contact-info-inner {
            width: min(75rem, 100%);
            margin-inline: auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            grid-template-rows: 250px 250px;
            gap: 1rem;
            align-items: stretch;
        }

        /* ========================================
           TEKST
           ======================================== */

        .info-text {
            grid-column: 1;
            grid-row: 1 / 3;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 500px;
        }

        .info-text > h2 {
            margin-bottom: 0.5rem;
            font: var(--body-sm);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        .info-text > h1 {
            margin: 0;
            font-size: 1.8rem;
            font: var(--heading-lg);
            letter-spacing: -0.03em;
            margin-bottom: 1rem;
        }

        .info-text > p {
            margin: 0 0 2rem;
            line-height: 1.6;
            font: var(--body-lg);
            color: var(--color-text-muted);
        }

        /* ========================================
           KONTAKT IKONER
           ======================================== */

        .info-icon {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        /* ========================================
           RUNDE IKONER
           ======================================== */

        .icon-circle {
            width: 55px;
            height: 55px;
            min-width: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        /* Telefon - grøn */

        .phone-circle {
            background-color: var(--color-green-400);
        }

        /* Åbningstider - orange */

        .clock-circle {
            background-color: #e8a15b;
        }

        /* Adresse - grå */

        .pin-circle {
            background-color: #b5b5b5;
        }

        /* ========================================
           SELVE IKONERNE
           ======================================== */

        .contact-icon {
            width: 24px;
            height: 24px;
            padding: 0;
            object-fit: contain;
        }

        /* ========================================
           TEKST VED SIDEN AF IKONERNE
           ======================================== */

        .icon-text {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
            margin-left: 0.5rem;
        }

        .icon-text h2 {
            line-height: 1.6;
            font: var(--body-lg);
            color: var(--color-text-muted);
        }
        .icon-text h3 {
            margin: 0;
            color: var(--color-text);
            font: var(--button-lg);
            letter-spacing: 0.5;
        }

        /* ========================================
           STORT BILLEDE
           ======================================== */

        .ContactImgLarge {
            grid-column: 2;
            grid-row: 1 / 3;
            position: relative;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* Stort billede */

        .ContactImgLarge .contact-img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 25px;
            position: relative;
            z-index: 2;
        }

        /* ========================================
           GRØN BOKS
           ======================================== */

        .green-box {
            position: absolute;
            width: 20rem;
            height: 9rem;
            left: -2rem;
            bottom: -1rem;
            background-color: var(--color-green-400);
            border-radius: 25px;
            z-index: 0;
        }

        /* ========================================
           LILLE BILLEDE 1
           ======================================== */

        .ContactImgSmallTop {
            grid-column: 3;
            grid-row: 1;

            width: 100%;
            height: 100%;
        }

        /* ========================================
           LILLE BILLEDE 2
           ======================================== */

        .ContactImgSmallBottom {
            grid-column: 3;
            grid-row: 2;

            width: 100%;
            height: 100%;
        }

        /* ========================================
           DE TO SMÅ BILLEDER
           ======================================== */

        .ContactImgSmallTop .contact-img,
        .ContactImgSmallBottom .contact-img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 25px;
        }
        /* ========================================
   TABLET
======================================== */

        @media (max-width: 900px) {
            /* Sektionen */
            .contact-info {
                margin-top: 8rem;
            }

            /* Mere luft i siderne */
            .contact-info-inner {
                width: calc(100% - 6rem);
                margin-inline: auto;
                grid-template-columns: 1fr 1fr 1fr;
                grid-template-rows: 220px 220px;
                gap: 1rem;
            }

            /* Tekst */
            .info-text {
                min-width: 0;
            }

            .info-text > h2 {
                margin-bottom: 0.5rem;
            }

            .info-text > h1 {
                margin-bottom: 0.75rem;
            }

            .info-text > p {
                margin-bottom: 1.5rem;
            }

            /* Kontaktoplysninger */
            .info-icon {
                gap: 0.75rem;
                margin-bottom: 1.25rem;
            }

            .icon-circle {
                width: 48px;
                height: 48px;
                min-width: 48px;
            }

            .contact-icon {
                width: 20px;
                height: 20px;
            }

            .icon-text {
                margin-left: 0;
                min-width: 0;
            }

            .icon-text h2 {
                font-size: 0.9rem;
            }

            .icon-text h3 {
                font-size: 1rem;
            }

            /* Stort billede */
            .ContactImgLarge {
                width: 100%;
                height: 100%;
            }

            .ContactImgLarge .contact-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            /* Grøn boks */
            .green-box {
                width: 8rem;
                height: 5rem;
                left: -0.5rem;
                bottom: -0.5rem;
                border-radius: 20px;
            }

            /* Små billeder */
            .ContactImgSmallTop,
            .ContactImgSmallBottom {
                width: 100%;
                height: 100%;
            }

            .ContactImgSmallTop .contact-img,
            .ContactImgSmallBottom .contact-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }

        /* ========================================
           MOBIL
           ======================================== */

        @media (max-width: 768px) {
            .contact-info {
                display: block;
                margin-top: 6rem;
            }

            .contact-info-inner {
                width: 100%;
                box-sizing: border-box;
                padding: 0 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            /* TEKST */

            .info-text {
                min-width: 0;
                width: 100%;
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
            }

            .info-text > h2 {
                margin-bottom: 0.5rem;
            }

            .info-text > h1 {
                margin-bottom: 0.75rem;
            }

            .info-text > p {
                margin-bottom: 1.5rem;
            }

            /* KONTAKT OPLYSNINGER */

            .info-icon {
                gap: 0.75rem;
                margin-bottom: 1.25rem;
            }

            .icon-circle {
                width: 48px;
                height: 48px;
                min-width: 48px;
            }

            .contact-icon {
                width: 20px;
                height: 20px;
            }

            .icon-text {
                margin-left: 0;
                min-width: 0;
            }

            .icon-text h2 {
                font-size: 0.9rem;
            }

            .icon-text h3 {
                font-size: 1rem;
            }

            /* BILLEDER */

            .ContactImgLarge,
            .ContactImgSmallTop,
            .ContactImgSmallBottom {
                width: 100%;
                height: auto;
            }

            .ContactImgLarge {
                position: relative;
                z-index: 1;
            }

            .ContactImgLarge .contact-img {
                width: 100%;
                height: auto;
                object-fit: cover;
                border-radius: 25px;
            }

            .ContactImgSmallTop .contact-img,
            .ContactImgSmallBottom .contact-img {
                width: 100%;
                height: auto;
                aspect-ratio: 1.5 / 1;
                object-fit: cover;
                border-radius: 25px;
            }

            /* GRØN BOKS */

            .green-box {
                width: 8rem;
                height: 5rem;
                left: -0.5rem;
                bottom: -0.5rem;
                border-radius: 20px;
            }
        }
    }
</style>
