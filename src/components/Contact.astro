---
import { Image } from "astro:assets";
import ContactImgOne from "@assets/images/contactimg1.png";
import ContactImgTwo from "@assets/images/contactimg2.png";
import ContactImgThree from "@assets/images/contactimg3.png";
import IconPhone from "../icons/phone.svg";
import IconClock from "../icons/clock.svg";
import IconPin from "../icons/pin.svg";
---

<section class="contact-info">
    <div class="contact-info-inner">
        <!-- Tekst -->
        <div class="info-text">
            <h2>Process</h2>

            <h1>Contact Us. It’s Easy.</h1>

            <p>
                Leverage agile frameworks to provide a robust synopsis for high
                level overviews. Iterative approaches to corporate strategy
                foster collaborative.
            </p>

            <div class="info-icon">
                <Image
                    class="contact-icon"
                    src={IconPhone}
                    alt="icon"
                />
                <h2>Call Today</h2>
                <h1>+1 800 100 900</h1>
            </div>

            <div class="info-icon">
                <Image
                    class="contact-icon"
                    src={IconClock}
                    alt="icon"
                />
                <h2>Monday To Friday</h2>
                <h1>9AM - 5PM</h1>
            </div>

            <div class="info-icon">
                <Image
                    class="contact-icon"
                    src={IconPin}
                    alt="icon"
                />
                <h2>USA Office</h2>
                <h1>195 Devonshire St Boston, MA 02110</h1>
            </div>
        </div>
        <!-- Billede med grøn dekorationsboks -->
        <div class="ContactImgLarge">
            <Image
                class="contact-img"
                src={ContactImgOne}
                alt="CONTACT"
            />
        </div>
        <div class="ContactImgSmallTop">
            <Image
                class="contact-img"
                src={ContactImgTwo}
                alt="CONTACT"
            />
        </div>
        <div class="ContactImgSmallBottom">
            <Image
                class="contact-img"
                src={ContactImgThree}
                alt="CONTACT"
            />
        </div>
    </div>
</section>

<style>
    @layer components {
        /* Sectionen går i fuld bredde */
        .contact-info {
            width: 100%;
            margin-top: 10rem;
        }

        /* Indholdet holdes i 1200px */
        .contact-info-inner {
            width: min(1200px, 100%);
            margin-inline: auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            grid-template-rows: 1fr 1fr 1fr;
            gap: 1rem;
            align-items: center;
        }
        .info-text {
            grid-column: 1;
            grid-row: 1 / 3;
        }
        .ContactImgLarge {
            grid-column: 2;
            grid-row: 1 / 3;
        }
        .ContactImgSmallTop {
            grid-column: 3;
            grid-row: 1;
        }

        .ContactImgSmallBottom {
            grid-column: 3;
            grid-row: 2;
        }

        /* Plads til den grønne boks */
        /* .info-image {
            position: relative;
            padding: 1.25rem;
        }*/

        /* .info-img {
            position: relative;
            display: block;
            width: 100%;
            height: auto;
            z-index: 1;
            border-radius: 25px;
        }*/

        /* Grøn boks bag billedet */
        /* .green-box {
            position: absolute;
            width: 10rem;
            height: 10rem;

            top: -0.5rem;
            left: -0.5rem;
            background-color: var(--color-green-400);
            z-index: 0;
            border-radius: 25px;
        }
/* styling af tekst */
        .info-icon {
            display: flex;
        }
    }
</style>
