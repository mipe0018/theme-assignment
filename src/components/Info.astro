---
import { Image } from "astro:assets";
import InfoImg from "@assets/images/InfoImg.png";
import checkmarkIcon from "../icons/checkmark.svg";
---

<section class="info">
  <div class="info-inner">
    <!-- Billede med grøn dekorationsboks -->
    <div class="info-image">
      <div class="green-box"></div>

      <Image
        class="info-img"
        src={InfoImg}
        alt="Info"
      />
    </div>

    <!-- Tekst -->
    <div class="info-text">
      <h2>WE'LL WORK WITH YOU</h2>

      <h1>What To Expect</h1>

      <p>
        Our collaboration is built on transparency, efficiency, and measurable
        results. Together, we create strategies tailored to your unique needs
        and goals.
      </p>

      <div class="about-text">
        <p class="about-text">
          <Image
            class="icon"
            src={checkmarkIcon}
            alt="ICON"
          />Collaborate to build actionable strategies that drive sustainable
          growth and deliver tangible outcomes.
        </p>
      </div>
      <div class="about-text">
        <p class="about-text">
          <Image
            class="icon"
            src={checkmarkIcon}
            alt="ICON"
          />Identify opportunities to optimize processes and implement impactful
          solutions with measurable results.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    /* Sectionen går i fuld bredde */
    .info {
      width: 100%;
      margin-top: 15rem;
    }

    /* Indholdet holdes i 1200px */
    .info-inner {
      width: min(75rem, 100%);
      margin-inline: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    /* Plads til den grønne boks */
    .info-image {
      position: relative;
      padding: 1.25rem;
    }

    .info-img {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      z-index: 1;
      border-radius: 25px;
    }

    /* Grøn boks bag billedet */
    .green-box {
      position: absolute;
      width: 10rem;
      height: 10rem;
      top: -0.5rem;
      left: -0.5rem;
      background-color: var(--color-green-400);
      z-index: 0;
      border-radius: 25px;
    }

    .info-text {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .info-text h1,
    .info-text h2,
    .info-text p {
      margin: 0;
    }

    .info-text h2 {
      /*uppercase overskrift*/
      font-size: 1rem;
      color: var(--color-blue-700, #2563eb);
      font: var(--body-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 1rem;
    }

    .info-text h1 {
      /*overskrift*/
      font-size: 1.8rem;
      font: var(--heading-lg);
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .info-text p {
      /*almindelig p tekst*/
      line-height: 1.6;
      font: var(--body-lg);
      color: var(--color-text-muted);
    }

    .icon {
      margin: 1rem;
      width: 2rem;
      height: 2rem;
      filter: invert(48%) sepia(79%) saturate(500%) hue-rotate(90deg);
    }
  }
</style>
