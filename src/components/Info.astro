---
import { Image } from "astro:assets";
import InfoImg from "@assets/images/InfoImg.png";
import checkmarkIcon from "../icons/checkmark.svg";
---

<section class="info">
  <div class="info-inner">
    <!-- Billede med grøn dekorationsboks -->
    <div class="info-image">
      <div class="green-box"></div>

      <Image
        class="info-img"
        src={InfoImg}
        alt="Info"
      />
    </div>

    <!-- Tekst -->
    <div class="info-text">
      <h2>WE'LL WORK WITH YOU</h2>

      <h1>What To Expect</h1>

      <p>
        Our collaboration is built on transparency, efficiency, and measurable
        results. Together, we create strategies tailored to your unique needs
        and goals.
      </p>

      <div class="about-text">
        <p class="about-text">
          <Image
            class="icon"
            src={checkmarkIcon}
            alt="ICON"
          />Collaborate to build actionable strategies that drive sustainable
          growth and deliver tangible outcomes.
        </p>
      </div>
      <div class="about-text">
        <p class="about-text">
          <Image
            class="icon"
            src={checkmarkIcon}
            alt="ICON"
          />Identify opportunities to optimize processes and implement impactful
          solutions with measurable results.
        </p>
      </div>
    </div>
  </div>
</section>
<style>
  @layer components {
    /* Sectionen går i fuld bredde */
    .info {
      width: 100%;
      margin-top: 15rem;
    }

    /* Indholdet holdes i 1200px */
    .info-inner {
      width: min(75rem, 100%);
      margin-inline: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    /* Plads til den grønne boks */
    .info-image {
      position: relative;
      padding: 1.25rem;
    }

    .info-img {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      z-index: 1;
      border-radius: 25px;
    }

    /* Grøn boks bag billedet */
    .green-box {
      position: absolute;
      width: 10rem;
      height: 10rem;
      top: -0.5rem;
      left: -0.5rem;
      background-color: var(--color-green-400);
      z-index: 0;
      border-radius: 25px;
    }

    .info-text {
      display: flex;
      align-items: center;
      flex-direction: column;
      gap: 0.75rem;
    }

    .info-text h1,
    .info-text h2,
    .info-text p {
      margin: 0;
    }

    .info-text h2 {
      font-size: 1rem;
      color: var(--color-blue-700, #2563eb);
      font: var(--body-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 1rem;
    }

    .info-text h1 {
      font-size: 1.8rem;
      font: var(--heading-lg);
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .info-text p {
      line-height: 1.6;
      font: var(--body-lg);
      color: var(--color-text-muted);
      display: flex;
    }

    .icon {
      margin: 1rem;
      width: 2rem;
      height: 2rem;
      filter: invert(48%) sepia(79%) saturate(500%) hue-rotate(90deg);
    }

    /* ========================================
       Responsive
    ========================================= */
    /* ========================================
   Tablet
======================================== */

    @media (max-width: 900px) {
      .info {
        margin-top: 4rem;
      }

      .info-inner {
        width: calc(100% - 6rem);
        margin-inline: auto;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
      }

      .info-image {
        padding: 1rem;
      }

      .green-box {
        width: 7.5rem;
        height: 7.5rem;
        top: -0.25rem;
        left: -0.25rem;
      }

      .info-text {
        align-items: flex-start;
        gap: 0.75rem;
      }

      .info-text h2 {
        margin-bottom: 0.5rem;
      }

      .info-text h1 {
        margin-bottom: 0.75rem;
      }

      .info-text > p {
        margin-bottom: 1rem;
      }

      .about-text {
        width: 100%;
      }

      .info-text .about-text p {
        align-items: flex-start;
      }

      .icon {
        flex-shrink: 0;
        width: 1.75rem;
        height: 1.75rem;
        margin: 0.5rem 0.75rem 0 0;
      }
    }
    /* ========================================
       Mobil
    ========================================= */

    @media (max-width: 768px) {
      .info {
        margin-top: 4rem;
      }

      .info-inner {
        width: 100%;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        padding: 0 1.5rem;
      }

      .info-image {
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem;
      }

      .info-img {
        width: 100%;
      }

      .green-box {
        width: 6rem;
        height: 6rem;
        top: -0.25rem;
        left: -0.25rem;
      }

      .info-text {
        width: 100%;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .info-text h2 {
        margin-bottom: 0.5rem;
      }

      .info-text h1 {
        margin-bottom: 0.75rem;
      }

      .info-text > p {
        margin-bottom: 1rem;
      }

      .about-text {
        width: 100%;
      }

      .info-text .about-text p {
        align-items: flex-start;
      }

      .icon {
        flex-shrink: 0;
        width: 1.5rem;
        height: 1.5rem;
        margin: 0.25rem 0.75rem 0 0;
      }
    }
  }
</style>
