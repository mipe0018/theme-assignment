---
/* =========================================
   FAQ DATA
   ========================================= */

const faqs = [
    {
        question: "What will happen when I’ve sent my application?",
        answer: "Once we receive your application, our team will review the information and get back to you with the next steps. We aim to make the process clear and straightforward from the beginning.",
    },
    {
        question: "Can I get a free trial before I purchase?",
        answer: "Depending on the service, we may be able to offer an initial consultation or demonstration so you can get a better understanding of what we offer before making a decision.",
    },
    {
        question: "What should I include in my personal statement?",
        answer: "Focus on your experience, strengths and what you hope to achieve. A clear overview of your goals and expectations helps us understand how we can support you.",
    },
    {
        question: "Will membership plans be charged automatically?",
        answer: "Payment terms depend on the selected plan. Before subscribing, you will be able to see the price, billing period and payment conditions clearly.",
    },
    {
        question: "What will happen when I’ve sent my application?",
        answer: "Results can vary depending on the project, goals and starting point. We focus on creating measurable improvements while building solutions that can support your business over time.",
    },
    {
        question: "Can I get a free trial before I purchase?",
        answer: "In many cases, plans can be adjusted as your needs change. Our team can help you explore the available options and find an arrangement that fits your situation.",
    },
];
---

<section class="faq">
    <div class="faq-container">
        <!-- =========================================
         FAQ HEADER
         ========================================= -->

        <div class="faq-header">
            <p class="faq-eyebrow">FAQ</p>

            <h2>Frequently Asked Questions</h2>

            <p class="faq-intro">
                Find answers to some of the most common questions about our
                services, process and collaboration.
            </p>
        </div>

        <!-- =========================================
         FAQ LISTE
         ========================================= -->

        <div class="faq-list">
            {
                faqs.map((faq) => (
                    <details class="faq-item">
                        <summary>
                            <span class="faq-question">{faq.question}</span>

                            <span class="faq-icon">+</span>
                        </summary>

                        <div class="faq-answer">
                            <p>{faq.answer}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* =========================================
   FAQ SEKTION
   ========================================= */

    .faq {
        width: 100%;
        padding: 2rem 1rem;
        background-color: #ffffff;
    }

    /* =========================================
   CONTAINER
   ========================================= */

    .faq-container {
        width: min(850px, 100%);
        margin: 0 auto;
    }

    /* =========================================
   HEADER
   ========================================= */

    .faq-header {
        text-align: center;
        max-width: 650px;
        margin: 0 auto 4rem;
    }

    /* =========================================
   EYEBROW
   ========================================= */

    .faq-eyebrow {
        margin: 0 0 0.75rem;
        color: var(--color-blue-700);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    /* =========================================
   OVERSKRIFT
   ========================================= */

    .faq-header h2 {
        margin: 0 0 1rem;
        color: var(--color-text);0
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1.1;
        padding: 1rem;
    }

    /* =========================================
   INTRO TEKST
   ========================================= */

    .faq-intro {
        margin: 0;
        color: #6b7280;
        font-size: 1rem;
        line-height: 1.7;
    }

    /* =========================================
   FAQ LISTE
   ========================================= */

    .faq-list {
        width: 100%;
    }

    /* =========================================
   FAQ ITEM
   ========================================= */

    .faq-item {
        border-top: 1px solid #dfe2e6;
    }

    /* Sidste linje får også en bund */
    .faq-item:last-child {
        border-bottom: 1px solid #dfe2e6;
    }

    /* =========================================
   SPØRGSMÅL
   ========================================= */

    .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.5rem 0;
        cursor: pointer;
        list-style: none;
    }

    /* Fjerner standard pil */
    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    /* =========================================
   SPØRGSMÅLSTEKST
   ========================================= */

    .faq-question {
        color: var(--color-text);
        font-size: 1.2rem;
        font-weight: 600;
        line-height: 1.5;
        padding: 1rem;
    }

    /* =========================================
   PLUS IKON
   ========================================= */

    .faq-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 50%;
        background-color: var(--color-blue-700);
        color: white;
        font-size: 1.5rem;
        font-weight: 300;
        line-height: 1;
        transition:
            transform 0.3s ease,
            background-color 0.3s ease;
    }

    /* =========================================
   NÅR FAQ ER ÅBEN
   ========================================= */

    .faq-item[open] .faq-icon {
        transform: rotate(45deg);
    }

    /* =========================================
   HOVER
   ========================================= */

    .faq-item summary:hover .faq-question {
        color: var(--color-blue-700);
    }

    .faq-item summary:hover .faq-icon {
        transform: scale(1.08);
    }

    /* Når den allerede er åben */
    .faq-item[open] summary:hover .faq-icon {
        transform: rotate(45deg) scale(1.08);
    }

    /* =========================================
   SVAR
   ========================================= */

    .faq-answer {
        padding: 0 4.5rem 1.5rem 0;
    }

    .faq-answer p {
        margin: 0;
        color: #6b7280;
        font-size: 1.2rem;
        line-height: 1.8;
    }

    /* =========================================
   MOBIL
   ========================================= */

    @media (max-width: 600px) {
 .faq {
    width: 100%;
    padding: 2rem 1rem 0;
    background-color: #ffffff;
}

        .faq-header {
            margin-bottom: 2.5rem;
        }

        .faq-item summary {
            padding: 1.25rem 0;
        }

        .faq-question {
            font-size: 0.95rem;
        }

        .faq-icon {
            width: 32px;
            height: 32px;

            font-size: 1.3rem;
        }

        .faq-answer {
            padding-right: 2rem;
        }
    }
</style>
