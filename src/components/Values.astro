---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

// Importerer ValuesCard-komponenten
import ValuesCard from "@components/ValuesCard.astro";

// Henter data fra API'et
const valuesData = await fetch("https://ftk-api.pages.dev/core-values").then(
    (res) => res.json(),
);

// Modtager variant fra den side, hvor komponenten bruges
interface Props {
    variant?: "default" | "alternative";
}

const { variant = "default" } = Astro.props;
---

<section class={`values-section values-${variant}`}>
    <div class="values-wrapper">
        <!-- Header med tekst og Get in touch-knap -->
        <div class="values-header">
            <div class="values-text">
                <!-- Eyebrow fra API'et -->
                <p class="eyebrow">
                    {valuesData.eyebrow}
                </p>

                <!-- Titel fra API'et -->
                <h2>
                    {valuesData.title}
                </h2>

                <!-- Undertitel fra API'et -->
                <p class="subtitle">
                    {valuesData.subtitle}
                </p>
            </div>

            <!-- Get in touch-knap fra API'et -->
            <a
                class="values-button"
                href="/#contact"
            >
                {valuesData.button.text}
            </a>
        </div>

        <!-- =========================================
             DESKTOP CARDS
             DENNE VERSION ER SOM FØR
        ========================================= -->
        <div class="values-cards desktop-values-cards">
            {
                valuesData.values.map((value: any) => (
                    <ValuesCard value={value} />
                ))
            }
        </div>

        <!-- =========================================
             MOBIL VERSION
        ========================================= -->
        <div class="mobile-values">
            <!-- Det valgte kort -->
            <div class="mobile-selected-card"></div>

            <!-- Valgmuligheder -->
            <div class="mobile-value-buttons">
                {
                    valuesData.values.map((value: any, index: number) => (
                        <button
                            type="button"
                            class:list={{ active: index === 0 }}
                            data-value-index={index}
                        >
                            {value.title}
                        </button>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    function setupValuesMobile() {
        const selectedCard = document.querySelector(".mobile-selected-card");

        const desktopCards = document.querySelectorAll(
            ".desktop-values-cards > *",
        );

        const buttons = document.querySelectorAll(
            ".mobile-value-buttons button",
        );

        if (!selectedCard || !desktopCards.length || !buttons.length) {
            return;
        }

        // Creative Ideas / første kort vises fra start
        selectedCard.innerHTML = desktopCards[0].outerHTML;

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const index = Number(button.getAttribute("data-value-index"));

                const selected = desktopCards[index];

                if (!selected) return;

                // Udskifter det store kort
                selectedCard.innerHTML = selected.outerHTML;

                // Fjerner active fra alle knapper
                buttons.forEach((item) => {
                    item.classList.remove("active");
                });

                // Gør det valgte korts knap active
                button.classList.add("active");
            });
        });
    }

    setupValuesMobile();

    document.addEventListener("astro:page-load", setupValuesMobile);
</script>

<style>
    /* =========================================
       HELE SEKTIONEN
       NORMAL VERSION
    ========================================= */

    .values-section {
        background-color: #030712;
        padding: 4rem 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.04) 1px,
                transparent 1px
            );
        background-size: 50px 50px;
        position: relative;
        overflow: hidden;
    }

    /* =========================================
       ALTERNATIVE VERSION
    ========================================= */

    .values-section.values-alternative {
        background-color: #d9d9d9 !important;
        background-image:
            linear-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 0, 0, 0.04) 1px, transparent 1px) !important;
    }

    /* =========================================
       NORMAL FADE
    ========================================= */

    .values-section::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(
            ellipse at center,
            transparent 20%,
            #030712 100%
        );
    }

    /* =========================================
       ALTERNATIVE FADE
    ========================================= */

    .values-section.values-alternative::after {
        background: radial-gradient(
            ellipse at center,
            transparent 20%,
            #d9d9d9 100%
        );
    }

    /* =========================================
       TEKST TIL ALTERNATIVE VERSION
    ========================================= */

    .values-section.values-alternative .eyebrow {
        color: #030712;
    }

    .values-section.values-alternative .values-text h2 {
        color: #030712;
    }

    .values-section.values-alternative .subtitle {
        color: #030712;
    }

    /* =========================================
       CONTENT
    ========================================= */

    .values-wrapper {
        width: min(75rem, calc(100% - 2rem));
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    /* =========================================
       HEADER
    ========================================= */

    .values-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .values-text {
        max-width: 650px;
    }

    /* =========================================
       EYEBROW
    ========================================= */

    .eyebrow {
        font-size: 1rem;
        color: var(--color-on-surface-elevated);
        font: var(--body-sm);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 1rem;
    }

    /* =========================================
       TITEL
    ========================================= */

    .values-text h2 {
        font-size: 1.8rem;
        font: var(--heading-lg);
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: var(--color-on-surface-elevated);
    }

    /* =========================================
       UNDERTITEL
    ========================================= */

    .subtitle {
        margin: 0;
        line-height: 1.6;
        font: var(--body-lg);
        color: var(--color-on-surface-elevated);
        max-width: 600px;
    }

    /* =========================================
       GET IN TOUCH KNAP
    ========================================= */

    .values-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.5rem;
        background-color: white;
        color: #030712;
        border-radius: 999px;
        text-decoration: none;
        white-space: nowrap;
        font-size: 0.9rem;
        transform: translateX(-4rem);
    }

    .values-section.values-alternative .values-button {
        background-color: var(--color-blue-700);
        color: var(--color-on-surface-elevated);
    }

    .values-button:hover {
        opacity: 0.8;
    }

    /* =========================================
       DESKTOP CARDS
    ========================================= */

    .values-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        padding: 0 1rem;
    }

    /* =========================================
       MOBIL VERSION
       SKJULT PÅ DESKTOP
    ========================================= */

    .mobile-values {
        display: none;
    }

    /* =========================================
       MOBIL
    ========================================= */

    @media (max-width: 768px) {
        .values-section {
            display: block;
            padding: 3.5rem 0;
        }

        .values-wrapper {
            width: calc(100% - 3rem);
            margin: 0 auto;
        }

        /* Header */

        .values-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .values-text {
            width: 100%;
            max-width: none;
        }

        .eyebrow {
            margin-bottom: 0.75rem;
            font-size: 0.85rem;
        }

        .values-text h2 {
            margin-bottom: 0.75rem;
            line-height: 1.2;
        }

        .subtitle {
            width: 100%;
            max-width: none;
        }

        /* Get in touch */

        .values-button {
            transform: none;
            align-self: flex-start;
        }

        /* Desktop cards skjules */

        .desktop-values-cards {
            display: none;
        }

        /* Mobil selected card */

        .mobile-values {
            display: block;
        }

        .mobile-selected-card {
            width: 100%;
            margin-bottom: 1.5rem;
        }
        /* =========================================
   VÆRDI-KNAPPER
========================================= */
        /* Knapper */

        .mobile-value-buttons {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: repeat(2, auto);
            gap: 0.5rem;
            width: 100%;
        }

        .mobile-value-buttons button {
            width: 100%;
            box-sizing: border-box;
            padding: 0.7rem 1rem;
            border: none;
            border-radius: 999px;
            background-color: var(--color-neutrals-200);
            color: var(--color-text);
            font: var(--button-sm);
            cursor: pointer;
            white-space: nowrap;
        }

        .mobile-value-buttons button.active {
            background-color: var(--color-blue-700);
            color: white;
        }
    }
</style>
