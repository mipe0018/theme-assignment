---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

// Importerer ValuesCard-komponenten
import ValuesCard from "@components/ValuesCard.astro";

// Henter data fra API'et
const valuesData = await fetch("https://ftk-api.pages.dev/core-values").then(
    (res) => res.json(),
);

// Modtager variant fra den side, hvor komponenten bruges
interface Props {
    variant?: "default" | "alternative";
}

const { variant = "default" } = Astro.props;
---

<section class={`values-section values-${variant}`}>
    <div class="values-wrapper">
        <!-- Header med tekst og Get in touch-knap -->
        <div class="values-header">
            <div class="values-text">
                <!-- Eyebrow fra API'et -->
                <p class="eyebrow">
                    {valuesData.eyebrow}
                </p>

                <!-- Titel fra API'et -->
                <h2>
                    {valuesData.title}
                </h2>

                <!-- Undertitel fra API'et -->
                <p class="subtitle">
                    {valuesData.subtitle}
                </p>
            </div>

            <!-- Get in touch-knap fra API'et -->
            <a
                class="values-button"
                href={valuesData.button.link}
            >
                {valuesData.button.text}
            </a>
        </div>

        <!-- Cards -->
        <div class="values-cards">
            {
                valuesData.values.map((value: any) => (
                    <ValuesCard value={value} />
                ))
            }
        </div>
    </div>
</section>

<style>
    /* =========================================
       HELE SEKTIONEN
       NORMAL VERSION
    ========================================= */

    .values-section {
        background-color: #030712;
        padding: 4rem 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.04) 1px,
                transparent 1px
            );

        background-size: 50px 50px;
        position: relative;
        overflow: hidden;
    }

    /* =========================================
       ALTERNATIVE VERSION
       
       Denne ændrer KUN den store baggrund
       BAG kortene.
       
       Kortene ændres ikke.
    ========================================= */

    .values-section.values-alternative {
        background-color: #d9d9d9 !important;
        background-image:
            linear-gradient(rgba(0, 0, 0, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 0, 0, 0.04) 1px, transparent 1px) !important;
    }

    /* =========================================
       NORMAL FADE
    ========================================= */

    .values-section::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(
            ellipse at center,
            transparent 20%,
            #030712 100%
        );
    }

    /* =========================================
       ALTERNATIVE FADE
       
       Sørger for at det mørke fade ikke
       lægger sig ovenpå den grå baggrund.
    ========================================= */

    .values-section.values-alternative::after {
        background: radial-gradient(
            ellipse at center,
            transparent 20%,
            #d9d9d9 100%
        );
    }
    /* =========================================
   TEKST TIL ALTERNATIVE VERSION
   ========================================= */

    .values-section.values-alternative .eyebrow {
        color: #030712;
    }

    .values-section.values-alternative .values-text h2 {
        color: #030712;
    }

    .values-section.values-alternative .subtitle {
        color: #030712;
    }

    /* =========================================
       CONTENT
    ========================================= */

    .values-wrapper {
        width: min(75rem, calc(100% - 2rem));
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    /* =========================================
       HEADER
    ========================================= */

    .values-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .values-text {
        max-width: 650px;
    }

    /* =========================================
       EYEBROW
    ========================================= */

    .eyebrow {
        font-size: 1rem;
        color: var(--color-on-surface-elevated);
        font: var(--body-sm);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 1rem;
    }

    /* =========================================
       TITEL
    ========================================= */

    .values-text h2 {
        font-size: 1.8rem;
        font: var(--heading-lg);
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: var(--color-on-surface-elevated);
    }

    /* =========================================
       UNDERTITEL
    ========================================= */

    .subtitle {
        margin: 0;
        line-height: 1.6;
        font: var(--body-lg);
        color: var(--color-on-surface-elevated);
        max-width: 600px;
    }

    /* =========================================
       GET IN TOUCH KNAP
    ========================================= */

    .values-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.5rem;
        background-color: white;
        color: #030712;
        border-radius: 999px;
        text-decoration: none;
        white-space: nowrap;
        font-size: 0.9rem;
    }

    .values-section.values-alternative .values-button {
        background-color: var(--color-blue-700);
        color: var(--color-on-surface-elevated);
    }

    .values-button:hover {
        opacity: 0.8;
    }

    /* =========================================
       CARDS
    ========================================= */

    .values-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        padding: 0 1rem;
    }

    /* =========================================
       TABLET
    ========================================= */

    @media (max-width: 900px) {
        .values-cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* =========================================
       MOBIL
    ========================================= */

    @media (max-width: 600px) {
        .values-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .values-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
