---
const iconFiles = import.meta.glob("../icons/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
});

interface Props {
    financial: {
        icon: string;
        title: string;
        description: string;
        link: {
            text: string;
            url: string;
        };
    };
}

const { financial } = Astro.props;

// API'et sender fx "cal", så vi finder cal.svg
const icon = iconFiles[`../icons/${financial.icon}.svg`];
---

<article class="financial-card">
    <div class="financial-icon">
        {
            icon && (
                <img
                    src={icon}
                    alt=""
                />
            )
        }
    </div>

    <h2>{financial.title}</h2>

    <p>{financial.description}</p>
</article>

<style>
    .financial-card {
        /* Laver afstand mellem ikon, overskrift og tekst */
        display: flex;
        flex-direction: column;
        gap: 1rem;

        /* Luft mellem indhold og kanten */
        padding: 2rem;

        /* Grå baggrund */
        background-color: #e5e5e5;

        /* Runde hjørner */
        border-radius: 25px;
    }
</style>
