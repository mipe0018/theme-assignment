---
interface Props {
    financial: {
        icon: string;
        title: string;
        description: string;
    };
}

const { financial } = Astro.props;
---

<article class="financial-card">
    <h2>{financial.title}</h2>
    <p>{financial.description}</p>
</article>

<style>
    .financial-card {
        padding: 2rem;
        background-color: white;
        border-radius: 1rem;
    }
</style>
