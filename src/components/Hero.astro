---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import ArrowRight from "@icons/arrow--right.svg";
import ArrowLeft from "@icons/arrow--left.svg";
---

<section class="hero">
  <!-- Billede uden for 1200px-container -->
  <Image
    class="hero-ceo"
    src={CEOImage}
    alt="CEO"
  />

  <!-- Indhold i 1200px -->
  <div class="hero-inner">
    <div class="hero-text">
      <h1>Empowering Your Business Growth</h1>

      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>

      <div class="hero-buttons">
        <a href="#0">Book a Meeting</a>
        <a href="#0">Learn More <ArrowRight class="arrow" /></a>
      </div>
    </div>

    <!-- Services hænger ud over hero -->
    <div class="hero-service-list">
      <Services />
    </div>
  </div>
</section>
<style>
  @layer components {
    /* Blå baggrund i fuld bredde */
    .hero {
      grid-column: a / d;
      position: relative;
      min-height: 28rem;
      background-color: var(--color-neutrals-900);
    }

    /* Indhold begrænset til 1200px */
    .hero-inner {
      width: min(75rem, 100%);
      height: 36rem;
      margin-inline: auto;
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      z-index: 1;
    }

    /* Billede fra midten til højre kant */
    .hero-ceo {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 50%;
      width: 50%;
      height: 100%;
      object-fit: cover;
      z-index: 0;

      /* Fader ind i den blå baggrund */
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 25%,
        black 100%
      );
    }

    .hero-text {
      grid-column: 1;
      align-self: center;
      max-width: 36rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      color: var(--color-on-surface-elevated);
      position: relative;
      z-index: 1;
    }

    .hero-text h1 {
      margin: 0;
      margin-top: -8rem;
      font-size: 1.8rem;
      font: var(--heading-lg);
      margin-bottom: 1rem;
    }

    .hero-text p {
      margin: 0;
      line-height: 1.6;
      font: var(--body-lg);
      color: var(--color-on-surface-elevated);
      letter-spacing: 0.5;
      opacity: 0.9;
    }

    .hero-buttons {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1rem;
    }

    .hero-buttons a:hover {
      opacity: 0.8;
    }

    .hero-buttons a {
      display: inline-flex;
      align-items: center;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      text-decoration: none;
      white-space: nowrap;
      font-family: var(--button-lg);
      gap: 1.5rem;
    }

    .hero-buttons a:first-child {
      background-color: var(--color-accent, #f5b83d);
      color: var(--color-blue-900, #0e1526);
    }

    .hero-buttons a:last-child {
      color: var(--color-on-ui-primary);
      border: 1px solid var(--color-on-ui-primary);
    }

    .arrow {
      width: 1rem;
      height: 1rem;
    }

    /* Services hænger ud over hero */
    .hero-service-list {
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 2;
      transform: translateY(50%);
      margin-top: 8rem;
    }
/* ========================================
   Responsive
======================================== */


/* ========================================
   Tablet
======================================== */

@media (max-width: 900px) {

    .hero {
        min-height: auto;
        padding-bottom: 2rem;
    }

    .hero-inner {
        width: 100%;
        height: auto;
        display: flex;
        flex-direction: column;
    }

    .hero-ceo {
        position: relative;
        inset: auto;
        width: 100%;
        height: 28rem;
        object-fit: cover;
        display: block;
        mask-image: none;
    }

    .hero-text {
        width: 100%;
        box-sizing: border-box;
        padding: 4rem 2rem;
        text-align: center;
        align-items: center;
    }

    .hero-text h1 {
        margin-top: 0;
        margin-bottom: 0.75rem;
    }

    .hero-text p {
        max-width: 40rem;
    }

    .hero-buttons {
        justify-content: center;
    }

    /* De tre services ligger under heroen */
    .hero-service-list {
        position: static;
        inset: auto;
        transform: none;
        width: 100%;
        margin: 0;
    }
}


/* ========================================
   Mobil
======================================== */

@media (max-width: 768px) {

    .hero {
        min-height: auto;
        padding-bottom: 2rem;
    }

    .hero-inner {
        width: 100%;
        height: auto;
        display: flex;
        flex-direction: column;
    }

    .hero-ceo {
        position: relative;
        inset: auto;
        width: 100%;
        height: 22rem;
        object-fit: cover;
        display: block;
        mask-image: none;
    }

    .hero-text {
        width: 100%;
        box-sizing: border-box;
        padding: 3rem 1.5rem;
        text-align: center;
        align-items: center;
    }

    .hero-service-list {
        position: static;
        inset: auto;
        transform: none;
        width: 100%;
        margin: 0;
    }

    /* Knapper i midten */
    .hero-text {
        align-items: center;
        text-align: center;
    }

    /* Typografi */
    .hero-text h1 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
}
</style>
