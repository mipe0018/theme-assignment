---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
---

<header>
    <div class="header-content">
        <a href="/">
            <Image
                src={logo}
                alt="Logo"
            />
        </a>

        <div class="menu">
            <a href="/">Home</a>
            <a href="/case-studies">Case Studies</a>
            <a href="/team">Team</a>
            <a href="/about">About</a>
        </div>

        <label
            for="login-toggle"
            class="login-button"
        >
            Login
        </label>
    </div>
</header>

<!-- =========================
     LOGIN POPUP
========================= -->

<input
    type="checkbox"
    id="login-toggle"
    class="login-toggle"
/>

<!-- Klik udenfor popup lukker den -->

<label
    for="login-toggle"
    class="login-backdrop"
></label>

<!-- =========================
     LOGIN BOX
========================= -->

<div class="login-popup">
    <label
        for="login-toggle"
        class="close-login"
    >
        ×
    </label>

    <h2>Dashboard Login</h2>

    <form>
        <label for="login-email"> Email Adress</label>

        <input
            type="email"
            id="login-email"
            placeholder="Enter your email"
        />

        <label for="login-password"> Password </label>

        <input
            type="password"
            id="login-password"
            placeholder="Enter your password"
        />

        <button type="submit"> Go to dashboard </button>
    </form>
</div>

<style>
    /* =========================
       HEADER
    ========================== */

    header {
        background-color: var(--color-neutrals-900);
        grid-column: a / d;
    }

    .header-content {
        max-width: 75rem;
        margin-inline: auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        padding: 20px;
    }

    .menu {
        display: flex;
        justify-content: center;
    }

    .menu a {
        text-decoration: none;
        color: var(--color-text-weak);
        padding: 0.7rem 1.1rem;
        font: var(--button-sm);
        letter-spacing: 0.5;
        padding-inline: 2rem;
    }

    .menu a:hover {
        color: var(--color-on-ui-primary);
    }

    .header-content button {
        background-color: var(--color-on-ui-primary);
        font-family: var(--font-heading);
        padding: 8px 20px;
        border-radius: 999px;
    }

    /* =========================
       LOGIN KNAP
    ========================== */

    .login-button {
        background-color: var(--color-on-ui-primary);
        font-family: var(--font-heading);
        border-radius: 999px;
        cursor: pointer;
        color: var(--color-text);
        padding: 0.7rem 1.1rem;
        font: var(--button-sm);
        letter-spacing: 0.5;
    }

    .login-button:hover {
        opacity: 0.8;
    }

    /* =========================
       SKJULT CHECKBOX
    ========================== */

    .login-toggle {
        position: fixed;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    /* =========================
       BAGGRUND / KLIK UDENFOR
    ========================== */

    .login-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9998;
        display: none;
        cursor: default;
    }

    /* Vis baggrund når popup er åben */

    .login-toggle:checked ~ .login-backdrop {
        display: block;
    }

    /* =========================
       LOGIN POPUP
    ========================== */

    .login-popup {
        position: fixed;
        top: 85px;
        right: max(calc((100vw - 75rem) / 2 + 20px), 20px);
        width: 350px;
        padding: 2rem;
        box-sizing: border-box;
        background: white;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-10px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            visibility 0.2s ease;
    }

    /* =========================
       ÅBEN POPUP
    ========================== */

    .login-toggle:checked ~ .login-popup {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    /* =========================
       LUK ×
    ========================== */

    .close-login {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 1.6rem;
        line-height: 1;
        color: #777;
        cursor: pointer;
    }

    .close-login:hover {
        color: #111;
    }

    /* =========================
       OVERSKRIFT
    ========================== */

    .login-popup h2 {
        margin: 0 0 1.2rem;
        font-family: var(--button-lg);
        font-size: 2rem;
    }

    /* =========================
       FORM
    ========================== */

    .login-popup form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .login-popup form label {
        margin-top: 0.4rem;
        font-family: var(--button-sm);
        font-size: 1rem;
        font-weight: 400;
        letter-spacing: 0.5;
    }

    /* =========================
       INPUTS
    ========================== */

    .login-popup input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 9px;
        background: var(--color-surface-secondary);
        color: #222;
        font-family: inherit;
        font-size: 0.9rem;
        border-radius: 999px;
    }

    .login-popup input:focus {
        outline: 2px solid var(--color-blue-700);

        border-color: transparent;
    }

    /* =========================
       DASHBOARD KNAP
    ========================== */

    .login-popup button {
        width: 100%;
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border: none;
        border-radius: 999px;
        background-color: var(--color-surface-highlight);
        color: var(--color-text);
        font-family: var(--font-heading);
        font-weight: 700;
        cursor: pointer;
    }

    .login-popup button:hover {
        opacity: 0.9;
    }
</style>
