---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
---

<header>
    <div class="header-content">
        <a href="/">
            <Image
                src={logo}
                alt="Logo"
            />
        </a>

        <div class="menu">
            <a href="/">Home</a>
            <a href="/case-studies">Case Studies</a>
            <a href="/team">Team</a>
            <a href="/about">About</a>
        </div>

        <label
            for="login-toggle"
            class="login-button"
        >
            Login
        </label>
    </div>
</header>

<!-- =========================
     MOBILE MENU TOGGLE
========================= -->

<input
    type="checkbox"
    id="menu-toggle"
    class="menu-toggle"
/>

<label
    for="menu-toggle"
    class="menu-button"
>
    ☰
</label>

<!-- =========================
     LOGIN TOGGLE
========================= -->

<input
    type="checkbox"
    id="login-toggle"
    class="login-toggle"
/>

<!-- =========================
     MOBILE MENU
========================= -->

<div class="mobile-menu">
    <label
        for="menu-toggle"
        class="close-menu"
    >
        ×
    </label>

    <nav>
        <a href="/">Home</a>
        <a href="/case-studies">Case Studies</a>
        <a href="/team">Team</a>
        <a href="/about">About</a>
    </nav>

    <label
        for="login-toggle"
        class="mobile-login-button"
    >
        Login
    </label>

    <!-- LOGIN POPUP PÅ MOBIL -->

    <div class="mobile-login-popup">
        <h2>Dashboard Login</h2>

        <form>
            <label for="mobile-login-email"> Email Adress </label>

            <input
                type="email"
                id="mobile-login-email"
                placeholder="Enter your email"
            />

            <label for="mobile-login-password"> Password </label>

            <input
                type="password"
                id="mobile-login-password"
                placeholder="Enter your password"
            />

            <button type="submit"> Go to dashboard </button>
        </form>
    </div>
</div>

<!-- =========================
     LOGIN BACKDROP
========================= -->

<label
    for="login-toggle"
    class="login-backdrop"
></label>

<!-- =========================
     DESKTOP LOGIN POPUP
========================= -->

<div class="login-popup">
    <label
        for="login-toggle"
        class="close-login"
    >
        ×
    </label>

    <h2>Dashboard Login</h2>

    <form>
        <label for="login-email"> Email Adress </label>

        <input
            type="email"
            id="login-email"
            placeholder="Enter your email"
        />

        <label for="login-password"> Password </label>

        <input
            type="password"
            id="login-password"
            placeholder="Enter your password"
        />

        <button type="submit"> Go to dashboard </button>
    </form>
</div>

<style>
    /* =========================
       HEADER
    ========================== */

    header {
        background-color: var(--color-neutrals-900);
        grid-column: a / d;
    }

    .header-content {
        max-width: 75rem;
        margin-inline: auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        padding: 20px;
    }

    .menu {
        display: flex;
        justify-content: center;
    }

    .menu a {
        text-decoration: none;
        color: var(--color-text-weak);
        padding: 0.7rem 1.1rem;
        font: var(--button-sm);
        letter-spacing: 0.5;
        padding-inline: 2rem;
    }

    .menu a:hover {
        color: var(--color-on-ui-primary);
    }

    /* LOGIN KNAP DESKTOP */

    .login-button {
        background-color: var(--color-on-ui-primary);
        font-family: var(--font-heading);
        border-radius: 999px;
        cursor: pointer;
        color: var(--color-text);
        padding: 0.7rem 1.1rem;
        font: var(--button-sm);
        letter-spacing: 0.5;
    }

    .login-button:hover {
        opacity: 0.8;
    }

    /* =========================
       MOBILE MENU
    ========================== */

    .menu-toggle {
        display: none;
    }

    .menu-button,
    .mobile-menu {
        display: none;
    }

    /* =========================
       LOGIN TOGGLE
    ========================== */

    .login-toggle {
        position: fixed;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    /* =========================
       LOGIN BACKDROP
    ========================== */

    .login-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9998;
        display: none;
        cursor: default;
    }

    .login-toggle:checked ~ .login-backdrop {
        display: block;
    }

    /* =========================
       DESKTOP LOGIN POPUP
    ========================== */

    .login-popup {
        position: fixed;
        top: 85px;
        right: max(calc((100vw - 75rem) / 2 + 20px), 20px);
        width: 350px;
        padding: 2rem;
        box-sizing: border-box;
        background: white;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-10px);
        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            visibility 0.2s ease;
    }

    .login-toggle:checked ~ .login-popup {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .close-login {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 1.6rem;
        line-height: 1;
        color: #777;
        cursor: pointer;
    }

    .close-login:hover {
        color: #111;
    }

    .login-popup h2,
    .mobile-login-popup h2 {
        margin: 0 0 1.2rem;
        font-family: var(--button-lg);
        font-size: 2rem;
    }

    .login-popup form,
    .mobile-login-popup form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .login-popup form label,
    .mobile-login-popup form label {
        margin-top: 0.4rem;
        font-family: var(--button-sm);
        font-size: 1rem;
        font-weight: 400;
        letter-spacing: 0.5;
    }

    .login-popup input,
    .mobile-login-popup input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 999px;
        background: var(--color-surface-secondary);
        color: #222;
        font-family: inherit;
        font-size: 0.9rem;
    }

    .login-popup input:focus,
    .mobile-login-popup input:focus {
        outline: 2px solid var(--color-blue-700);
        border-color: transparent;
    }

    .login-popup button,
    .mobile-login-popup button {
        width: 100%;
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border: none;
        border-radius: 999px;
        background-color: var(--color-surface-highlight);
        color: var(--color-text);
        font-family: var(--font-heading);
        font-weight: 700;
        cursor: pointer;
    }

    .login-popup button:hover,
    .mobile-login-popup button:hover {
        opacity: 0.9;
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 768px) {
        .header-content {
            grid-template-columns: 1fr auto;
        }

        /* Skjul desktop-menu */

        .menu {
            display: none;
        }

        /* Skjul desktop-login */

        .login-button {
            display: none;
        }

        /* Hamburger */

        .menu-button {
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            color: var(--color-on-ui-primary);
            font-size: 2rem;
            line-height: 1;
            cursor: pointer;
            z-index: 10001;
        }

        /* =========================
           SELVE MOBILMENUEN
        ========================== */

        .mobile-menu {
            position: fixed;
            top: 0;
            right: 0;
            width: min(85%, 400px);
            height: 100svh;
            box-sizing: border-box;
            padding: 6rem 2rem 2rem;
            background-color: var(--color-neutrals-900);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            transform: translateX(100%);
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        /* ÅBN MENU */

        .menu-toggle:checked ~ .mobile-menu {
            transform: translateX(0);
        }

        /* =========================
           LUK-KRYDS
        ========================== */

        .close-menu {
            position: absolute;
            top: 20px;
            left: 20px;
            color: var(--color-on-ui-primary);
            font-size: 2.5rem;
            line-height: 1;
            cursor: pointer;
        }

        /* =========================
           LINKS
        ========================== */

        .mobile-menu nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .mobile-menu nav a {
            text-decoration: none;
            color: var(--color-text-weak);
            font: var(--button-sm);
            padding: 1rem 0;
            border-bottom: 1px solid var(--color-text-muted);
        }

        .mobile-menu nav a:hover {
            color: var(--color-on-ui-primary);
        }

        /* =========================
           LOGIN KNAP
        ========================== */

        .mobile-login-button {
            margin-top: 2rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.9rem 1.2rem;
            background-color: var(--color-on-ui-primary);
            color: var(--color-text);
            border-radius: 999px;
            font: var(--button-sm);
            cursor: pointer;
        }

        .mobile-login-button:hover {
            opacity: 0.8;
        }

        /* =========================
           LOGIN POPUP I MENUEN
        ========================== */

        .mobile-login-popup {
            display: none;
            margin-top: 1.5rem;
            padding: 1.5rem;
            background-color: white;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .login-toggle:checked ~ .mobile-menu .mobile-login-popup {
            display: block;
        }

        /* Skjul desktop-popup på mobil */

        .login-popup {
            display: none;
        }

        /* Backdrop bruges ikke på mobil */

        .login-backdrop {
            display: none !important;
        }
    }
</style>
