<section class="newsletter">
    <div class="newsletter-inner">
        <h2>STAY UPDATED</h2>
        <h1>Subscribe Our Newsletter</h1>
        <p>
            Build stronger Customer Relationships with <span>Consultalk</span>
        </p>

        ```
        <!-- Formular med inputfelt til email og subscribe-knap -->
        <div class="newsletter-form">
            <!-- Brugeren indtaster sin emailadresse her -->
            <input
                type="email"
                placeholder="Your email address"
            />
            <!-- Sender formularen -->
            <button>Subscribe</button>
        </div>
    </div>
</section>

<style>
    @layer components {
        /* Sektionen går i fuld bredde */
        .newsletter {
            grid-column: a / d;
            width: 100%;
            margin-top: 8rem;
            margin-bottom: -4rem;
            background-color: var(--color-neutrals-900);
        }

        /* Begrænser indholdet til maks. 1200px */
        .newsletter-inner {
            width: min(75rem, 100%);
            margin-inline: auto;
            padding-block: 4rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .newsletter-inner h2,
        .newsletter-inner h1,
        .newsletter-inner p {
            margin: 0;
        }

        /* Lille overskrift */
        .newsletter-inner h2 {
            font-size: 0.9rem;
            color: var(--color-surface-highlight);
            font: var(--body-sm);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            margin-bottom: 0.5rem;
        }

        /* Hovedoverskrift */
        .newsletter-inner h1 {
            color: var(--color-on-ui-primary);
            font-size: 1.8rem;
            font: var(--heading-lg);
            letter-spacing: -0.03em;
            margin-bottom: 1rem;
        }

        /* Teksten under overskriften */
        .newsletter-inner p {
            line-height: 1.6;
            font: var(--body-lg);
            color: var(--color-text-muted);
        }

        /* Fremhæver Consultalk */
        .newsletter-inner p span {
            color: var(--color-surface-highlight);
        }

        /* Placering af inputfelt og knap */
        .newsletter-form {
            display: flex;
            gap: 0.75rem;
        }

        /* Emailfeltet er dobbelt så bredt som knappen */
        input {
            width: 300px;
            background-color: var(--color-neutrals-900);
            font-family: var(--font-heading);
            padding: 20px 16px;
            border: none;
            border-radius: 999px;
            font-size: 1rem;
            border: 1px solid var(--color-on-ui-primary-muted);
            color: var(--color-on-ui-primary-muted);
        }

        /* Subscribe-knappen */
        button {
            background-color: var(--color-action);
            font-family: var(--font-heading);
            padding: 20px 40px;
            color: var(--color-text);
            font: var(--button-sm);
            letter-spacing: 0.5;
            border: none;
            border-radius: 999px;
            font-size: 1rem;
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        button:hover {
            opacity: 0.8;
        }
/* =========================
       MOBILE
========================== */

@media (max-width: 768px) {

    .newsletter {
        margin-top: 4rem;
        margin-bottom: -2rem;
    }

    .newsletter-inner {
        width: 100%;
        box-sizing: border-box;
        padding: 2.5rem 1.5rem 3.5rem;
    }

    .newsletter-inner h2 {
        margin-bottom: 0.25rem;
        font-size: 0.8rem;
    }

    .newsletter-inner h1 {
        font-size: 2.2rem;
        line-height: 1.1;
        margin-bottom: 0.75rem;
    }

    .newsletter-inner p {
        max-width: 20rem;
        margin-inline: auto;
        font-size: 1rem;
        line-height: 1.5;
    }

    .newsletter-form {
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 300px;
        margin-top: 1.25rem;
        gap: 0.6rem;
    }

    .newsletter-form input {
        width: 100%;
        box-sizing: border-box;
        padding: 15px 18px;
    }

    .newsletter-form button {
        width: 100%;
        padding: 15px 18px;
    }
}


</style>
