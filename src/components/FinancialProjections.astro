---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

import ArrowRight from "@icons/arrow--right.svg";
import ArrowLeft from "@icons/arrow-left.svg";

// Importerer FinancialCard-komponenten
import FinancialCard from "@components/FinancialCard.astro";

// Henter financial-data fra API'et
const financialData = await fetch(
    "https://ftk-api.pages.dev/financial-projections",
).then((res) => res.json());
---

<div class="financial-wrapper">

    <!-- Header med tekst og carousel-knapper -->
    <div class="financial-header">

        <div class="financial-text">
            <!-- Henter eyebrow fra API'et -->
            <p class="eyebrow">
                {financialData.eyebrow}
            </p>

            <!-- Henter titel fra API'et -->
            <h1>{financialData.title}</h1>

            <!-- Henter undertitel fra API'et -->
            <p>{financialData.subtitle}</p>
        </div>

        <!-- Knapper til at styre carousel -->
        <div class="carousel-buttons">

            <!-- Knap til at scrolle tilbage -->
            <button
                id="previous"
                aria-label="Forrige"
            >
                <ArrowLeft class="arrow" />
            </button>

            <!-- Knap til at scrolle frem -->
            <button
                id="next"
                aria-label="Næste"
            >
                <ArrowRight class="arrow" />
            </button>

        </div>
    </div>
</div>


<!-- Carousel med alle financial cards -->
<div
    class="financial-cards"
    id="financial-cards"
>
    {
        financialData.values.map((financial: any) => (
            <div class="financial-card-wrapper">
                <!-- Sender data fra API'et videre til FinancialCard -->
                <FinancialCard financial={financial} />
            </div>
        ))
    }
</div>




<script>
    document.addEventListener("astro:page-load", () => {
        const cards = document.querySelector("#financial-cards");
        const previous = document.querySelector("#previous");
        const next = document.querySelector("#next");

        if (!cards || !previous || !next) return;

        next.addEventListener("click", () => {
            const card = cards.querySelector(".financial-card-wrapper");

            if (!card) return;

            const cardWidth = card.getBoundingClientRect().width;
            const gap = 16;

            cards.scrollBy({
                left: cardWidth + gap,
                behavior: "smooth",
            });
        });

        previous.addEventListener("click", () => {
            const card = cards.querySelector(".financial-card-wrapper");

            if (!card) return;

            const cardWidth = card.getBoundingClientRect().width;
            const gap = 16;

            cards.scrollBy({
                left: -(cardWidth + gap),
                behavior: "smooth",
            });
        });
    });
</script>

<style>
    /* --- Hele sektionen --- */
    .financial-wrapper {
        width: min(75rem, 100%);
        margin: 8rem auto 0;
    }


    /* --- Header --- */
    .financial-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
    }

    .financial-text {
        max-width: 650px;
    }

    .financial-text .eyebrow {
        margin: 0;
        font: var(--body-sm);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .financial-text h1 {
        margin: 0.5rem 0 1rem;
        font: var(--heading-lg);
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
    }

    .financial-text p {
        margin: 0;
        line-height: 1.6;
        font: var(--body-lg);
        color: var(--color-text-muted);
    }


    /* --- Carousel-knapper --- */
    .carousel-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .carousel-buttons button {
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 50%;
        background-color: var(--color-blue-700);
        color: white;
        font-size: 1.5rem;
        line-height: 1;
        padding: 0;
        cursor: pointer;
        transform: translateX(-4rem);
    }

    .carousel-buttons button:hover {
        opacity: 0.8;
    }

    .arrow {
        width: 1rem;
        height: 1rem;
    }


    /* --- Cards / carousel --- */
    .financial-cards {
        width: 90vw;
        margin-left: calc(50% - 45vw);
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    /* Skjuler scrollbar i Chrome/Edge */
    .financial-cards::-webkit-scrollbar {
        display: none;
    }

    /* Bestemmer hvor mange cards der kan ses */
    .financial-card-wrapper {
        flex: 0 0 calc((90vw - 3rem) / 4);
        scroll-snap-align: start;
    }


    /* ========================================
       Responsive
    ========================================= */


    /* ========================================
       Tablet
    ========================================= */

    @media (max-width: 900px) {

        .financial-wrapper {
            width: calc(100% - 6rem);
            margin: 5rem auto 0;
        }

        .financial-header {
            align-items: flex-end;
            gap: 2rem;
        }

        .financial-text {
            max-width: 100%;
        }

        .carousel-buttons {
            flex-shrink: 0;
        }

        .carousel-buttons button {
            transform: none;
        }

        .financial-cards {
            width: 100%;
            margin-left: 0;
            gap: 1rem;
        }

        /* Tre cards på tablet */
        .financial-card-wrapper {
            flex: 0 0 calc((100% - 2rem) / 3);
        }
    }


    /* ========================================
       Mobil
    ========================================= */

    @media (max-width: 768px) {

        /* Hele sektionen */
        .financial-wrapper {
            width: 100%;
            box-sizing: border-box;
            margin: 5rem 0 0;
            padding: 0 1.5rem;
        }

        /* Header */
        .financial-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .financial-text {
            width: 100%;
            max-width: none;
        }

        .financial-text h1 {
            margin: 0.5rem 0 0.75rem;
        }

        .financial-text p {
            line-height: 1.6;
        }

        /* Carousel-knapper */
        .carousel-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .carousel-buttons button {
            width: 2.75rem;
            height: 2.75rem;
            transform: none;
        }

        /* Carousel */
        .financial-cards {
            width: 90vw;
            margin-left: 0;
            padding-left: 1.5rem;
            box-sizing: border-box;
            gap: 1rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
        }

        /* Ét kort ad gangen */
        .financial-card-wrapper {
            flex: 0 0 calc(90vw - 3rem);
            scroll-snap-align: start;
        }
    }
</style>