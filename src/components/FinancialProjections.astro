---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

// Importerer FinancialCard-komponenten
import FinancialCard from "@components/FinancialCard.astro";

// Henter financial-data fra API'et
const financialData = await fetch(
    "https://ftk-api.pages.dev/financial-projections",
).then((res) => res.json());
---

<div class="financial-wrapper">

    <!-- Header med tekst og carousel-knapper -->
    <div class="financial-header">

        <div class="financial-text">

            <!-- Henter eyebrow fra API'et -->
            <p class="eyebrow">
                {financialData.eyebrow}
            </p>

            <!-- Henter titel fra API'et -->
            <h1>{financialData.title}</h1>

            <!-- Henter undertitel fra API'et -->
            <p>{financialData.subtitle}</p>

        </div>

        <!-- Knapper til at styre carousel -->
        <div class="carousel-buttons">

            <!-- Knap til at scrolle tilbage -->
            <button
                id="previous"
                aria-label="Forrige"
            >
                ←
            </button>

            <!-- Knap til at scrolle frem -->
            <button
                id="next"
                aria-label="Næste"
            >
                →
            </button>

        </div>
    </div>


    <!-- Carousel med alle financial cards -->
    <div
        class="financial-cards"
        id="financial-cards"
    >
        {
            financialData.values.map((financial: any) => (
                <div class="financial-card-wrapper">

                    <!-- Sender data fra API'et videre til FinancialCard -->
                    <FinancialCard financial={financial} />

                </div>
            ))
        }
    </div>

</div>


<script>
    // Finder carousel-containeren
    const cards = document.querySelector("#financial-cards");

    // Finder knappen til at scrolle tilbage
    const previous = document.querySelector("#previous");

    // Finder knappen til at scrolle frem
    const next = document.querySelector("#next");


    // Scroller carousel'et frem
    function scrollNext() {

        // Stopper hvis carousel-containeren ikke findes
        if (!cards) return;

        // Finder det første card
        const card = cards.querySelector(".financial-card-wrapper");

        // Stopper hvis der ikke findes et card
        if (!card) return;

        // Finder bredden på cardet
        const cardWidth = card.getBoundingClientRect().width;

        // Afstanden mellem cards er 16px
        const gap = 16;

        // Scroller én card-bredde + gap frem
        cards.scrollBy({
            left: cardWidth + gap,
            behavior: "smooth",
        });
    }


    // Scroller carousel'et tilbage
    function scrollPrevious() {

        // Stopper hvis carousel-containeren ikke findes
        if (!cards) return;

        // Finder det første card
        const card = cards.querySelector(".financial-card-wrapper");

        // Stopper hvis der ikke findes et card
        if (!card) return;

        // Finder bredden på cardet
        const cardWidth = card.getBoundingClientRect().width;

        // Afstanden mellem cards er 16px
        const gap = 16;

        // Scroller én card-bredde + gap tilbage
        cards.scrollBy({
            left: -(cardWidth + gap),
            behavior: "smooth",
        });
    }


    // Kører scrollNext når der klikkes på næste-knappen
    next?.addEventListener("click", scrollNext);

    // Kører scrollPrevious når der klikkes på forrige-knappen
    previous?.addEventListener("click", scrollPrevious);
</script>


<style>

    /* --- Hele sektionen --- */

    .financial-wrapper {
        /* Maksimal bredde på hele sektionen */
        width: min(1200px, 100%);

        margin: 8rem auto 0;
    }


    /* --- Header --- */

    .financial-header {
        display: flex;
        justify-content: space-between;

        /* Knapperne flugter med bunden */
        align-items: flex-end;

        margin-bottom: 2rem;
    }

    .financial-text {
        max-width: 650px;
    }

    .financial-text .eyebrow {
        margin: 0;
    }

    .financial-text h1 {
        margin: 0.5rem 0 1rem;
    }

    .financial-text p {
        margin: 0;
    }


    /* --- Carousel-knapper --- */

    .carousel-buttons {
        display: flex;

        /* Afstand mellem knapperne */
        gap: 0.5rem;
    }

    .carousel-buttons button {
        width: 3rem;
        height: 3rem;

        /* Fjern standard border */
        border: none;

        /* Gør knappen rund */
        border-radius: 50%;

        /* Knapfarve – skift farven her */
        background-color: var(--color-blue-700);

        color: white;
        font-size: 1.5rem;

        /* Giver hånd-cursor ved hover */
        cursor: pointer;
    }

    .carousel-buttons button:hover {
        opacity: 0.8;
    }


    /* --- Cards / carousel --- */

    .financial-cards {
        display: flex;

        /* Afstand mellem cards */
        gap: 1rem;

        /* Gør det muligt at scrolle vandret */
        overflow-x: auto;

        /* Glidende scrolling */
        scroll-behavior: smooth;

        /* Hvert card stopper ved starten */
        scroll-snap-type: x mandatory;

        /* Skjuler scrollbar */
        scrollbar-width: none;
    }

    /* Skjuler scrollbar i Chrome/Edge */
    .financial-cards::-webkit-scrollbar {
        display: none;
    }

    /* Bestemmer hvor mange cards der kan ses */
    .financial-card-wrapper {

        /* 4 cards med 1rem mellem hvert card */
        flex: 0 0 calc((100% - 3rem) / 4);

        /* Cardet snapper til venstre side */
        scroll-snap-align: start;
    }


    /* --- Mobil --- */

    @media (max-width: 800px) {

        .financial-header {

            /* Header bliver lodret på mindre skærme */
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }

        .financial-card-wrapper {

            /* På mobil vises ét card ad gangen */
            flex: 0 0 85%;
        }
    }

</style>