---
/* ========================================
   PROPS
======================================== */

interface Props {
    team: {
        id: number;
        name: string;
        title: string;
        description: string;
        slug: string;
        image: {
            src: string;
            alt: string;
            width: number;
            height: number;
        };
    };

    variant?: "default" | "compact";
}

const { team, variant = "default" } = Astro.props;

/* ========================================
   IKONER
======================================== */

const iconFiles = import.meta.glob("../icons/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
});

const instagramIcon = iconFiles["../icons/instagram.svg"];
const facebookIcon = iconFiles["../icons/facebook.svg"];
---

<a
    href={`/team/${team.slug}`}
    class={`team-button ${variant}`}
>
    <article class="teams-card">
        <!-- ========================================
             TEAM IMAGE
        ========================================= -->

        <div class="team-image">
            <img
                src={team.image.src}
                alt={team.image.alt}
                width={team.image.width}
                height={team.image.height}
            />

            {variant === "default" && <div class="read-more">Read more →</div>}

            {
                variant === "default" && (
                    <div class="team-title">{team.title}</div>
                )
            }
        </div>

        <!-- ========================================
             NORMAL VARIANT
        ========================================= -->

        {
            variant === "default" && (
                <div class="team-content">
                    <h2>{team.name}</h2>

                    <p class="team-description">{team.description}</p>

                    <div class="social-icons">
                        {instagramIcon && (
                            <img
                                src={instagramIcon}
                                alt="Instagram"
                            />
                        )}

                        {facebookIcon && (
                            <img
                                src={facebookIcon}
                                alt="Facebook"
                            />
                        )}
                    </div>
                </div>
            )
        }
    </article>
</a>

<style>
    /* ========================================
   NORMAL TEAM CARD
======================================== */

    .team-button {
        display: block;
        width: 100%;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .teams-card {
        display: grid;
        grid-template-rows: auto 1fr;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #e5e5e5;
        border-radius: 25px;
    }

    /* ========================================
   TEAM IMAGE
======================================== */

    .team-image {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 25px 25px 0 0;
    }

    .team-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .team-button:hover .team-image img {
        transform: scale(1.03);
    }

    /* ========================================
   READ MORE
======================================== */

    .read-more {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2;
        padding: 0.8rem 1.3rem;
        color: white;
        background-color: var(--color-blue-700);
        font-size: 0.9rem;
        font-weight: 700;
        border-radius: 0 0 18px 0;
    }

    /* ========================================
   TEAM TITLE
======================================== */

    .team-title {
        position: absolute;
        right: 15px;
        bottom: 15px;
        z-index: 2;
        padding: 0.65rem 1.1rem;
        color: white;
        background-color: rgba(0, 0, 0, 0.65);
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        backdrop-filter: blur(5px);
    }

    /* ========================================
   NORMAL TEAM CONTENT
======================================== */

    .team-content {
        display: flex;
        flex-direction: column;
        min-height: 260px;
        padding: 1.5rem;
    }

    .team-content h2 {
        margin: 0 0 0.5rem;
    }

    .team-description {
        margin: 0;
        min-height: 5.2em;
        line-height: 1.6;
    }

    /* ========================================
   SOCIAL ICONS
======================================== */

    .social-icons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        margin-top: auto;
        padding-top: 1.5rem;
    }

    .social-icons img {
        width: 38px;
        height: 38px;
        object-fit: contain;
        transition: transform 0.2s ease;
    }

    .social-icons img:hover {
        transform: scale(1.1);
    }

    /* ========================================
   COMPACT VARIANT
   KUN BILLEDET
======================================== */

    .compact {
        display: block;
        width: 155px;
        height: 155px;
        flex: 0 0 155px;
    }

    .compact .teams-card {
        display: block;
        width: 155px;
        height: 155px;
        overflow: visible;
        background: transparent;
        border-radius: 0;
    }

    /* ========================================
   COMPACT BILLEDE

   HER ER HØJDEN/BREDDEN PÅ BILLEDERNE
======================================== */

    .compact .team-image {
        width: 155px;
        /* ÆNDRER DU HØJDEN, ER DET HER */
        height: 155px;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 22px;
    }

    .compact .team-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ========================================
   MOBILE
======================================== */

    @media (max-width: 500px) {
        .compact {
            width: 85px;
            height: 85px;
            flex: 0 0 85px;
        }

        .compact .teams-card {
            width: 85px;
            height: 85px;
        }

        .compact .team-image {
            width: 85px;
            height: 85px;
        }
    }
</style>
