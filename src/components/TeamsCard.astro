---
interface Props {
    team: {
        id: number;
        name: string;
        title: string;
        description: string;
        slug: string;
        image: {
            src: string;
            alt: string;
            width: number;
            height: number;
        };
    };
}

const { team } = Astro.props;

// Finder SVG-ikonerne i src/icons
const iconFiles = import.meta.glob("../icons/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
});

// Finder ikonerne
const instagramIcon = iconFiles["../icons/instagram.svg"];
const facebookIcon = iconFiles["../icons/facebook.svg"];
---

<a
    href={`/team/${team.slug}`}
    class="team-button"
>
    <article class="teams-card">
        <!-- Billede -->
        <div class="team-image">
            <img
                src={team.image.src}
                alt={team.image.alt}
                width={team.image.width}
                height={team.image.height}
            />

            <!-- Read more -->
            <div class="read-more">Read more →</div>

            <!-- Jobtitel -->
            <div class="team-title">
                {team.title}
            </div>
        </div>

        <!-- Indhold -->
        <div class="team-content">
            <!-- Navn -->
            <h2>
                {team.name}
            </h2>

            <!-- Beskrivelse -->
            <p class="team-description">
                {team.description}
            </p>

            <!-- Sociale medier -->
            <div class="social-icons">
                {
                    instagramIcon && (
                        <img
                            src={instagramIcon}
                            alt="Instagram"
                        />
                    )
                }

                {
                    facebookIcon && (
                        <img
                            src={facebookIcon}
                            alt="Facebook"
                        />
                    )
                }
            </div>
        </div>
    </article>
</a>

<style>
    /* ========================= */
    /* LINK */
    /* ========================= */

    .team-button {
        display: block;

        width: 100%;
        height: 100%;

        color: inherit;
        text-decoration: none;
    }

    /* ========================= */
    /* CARD */
    /* ========================= */

    .teams-card {
        display: grid;

        grid-template-rows: auto 1fr;

        width: 100%;
        height: 100%;

        overflow: hidden;

        background-color: #e5e5e5;

        border-radius: 25px;
    }

    /* ========================= */
    /* IMAGE */
    /* ========================= */

    .team-image {
        position: relative;

        width: 100%;

        aspect-ratio: 1 / 1;

        overflow: hidden;

        border-radius: 25px 25px 0 0;
    }

    .team-image img {
        display: block;

        width: 100%;
        height: 100%;

        object-fit: cover;

        transition: transform 0.3s ease;
    }

    .team-button:hover .team-image img {
        transform: scale(1.03);
    }

    /* ========================= */
    /* READ MORE */
    /* ========================= */

    .read-more {
        position: absolute;

        top: 0;
        left: 0;

        z-index: 2;

        padding: 0.8rem 1.3rem;

        color: white;

        background-color: var(--color-blue-700);

        font-size: 0.9rem;
        font-weight: 700;

        border-radius: 0 0 18px 0;
    }

    /* ========================= */
    /* TITLE */
    /* ========================= */

    .team-title {
        position: absolute;

        right: 15px;
        bottom: 15px;

        z-index: 2;

        padding: 0.65rem 1.1rem;

        color: white;

        background-color: rgba(0, 0, 0, 0.65);

        border-radius: 999px;

        font-size: 0.85rem;
        font-weight: 600;

        backdrop-filter: blur(5px);
    }

    /* ========================= */
    /* CONTENT */
    /* ========================= */

    .team-content {
        display: flex;

        flex-direction: column;

        min-height: 260px;

        padding: 1.5rem;
    }

    .team-content h2 {
        margin: 0 0 0.5rem;
    }

    /* Beskrivelsen får et fast område */

    .team-description {
        margin: 0;

        line-height: 1.6;

        min-height: 5.2em;
    }

    /* ========================= */
    /* SOCIAL ICONS */
    /* ========================= */

    .social-icons {
        display: flex;

        justify-content: center;
        align-items: center;

        gap: 1.5rem;

        margin-top: auto;
        padding-top: 1.5rem;
    }

    .social-icons img {
        width: 38px;
        height: 38px;

        object-fit: contain;

        transition: transform 0.2s ease;
    }

    .social-icons img:hover {
        transform: scale(1.1);
    }
</style>
