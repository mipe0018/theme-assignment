---
/* @ts-nocheck bruges til at undgå TypeScript-fejl */

// Importerer TeamsCard-komponenten
import TeamsCard from "@components/TeamsCard.astro";

// Henter team-data fra API'et
const TeamsData = await fetch("https://ftk-api.pages.dev/team").then((res) =>
    res.json(),
);
---

<div class="teams-wrapper">
    <!-- Header med tekst og knap -->
    <div class="teams-header">
        <div class="teams-text">
            <!-- Hovedoverskrift -->
            <h1>Meet Our Great Team</h1>

            <!-- Beskrivelse -->
            <p>
                Welcome to our amazing team! We are a group of passionate
                individuals dedicated to excellence and innovation. Each member
                brings unique skills and experiences, working together to
                achieve our goals. Join us as we embark on exciting projects and
                create lasting impacts.
            </p>
        </div>

        <!-- Join our team knap -->
        <a
            href="/contact"
            class="join-button"
        >
            Join Our Team
        </a>
    </div>

    <!-- Grid med alle team cards -->
    <div class="teams-cards">
        {TeamsData.map((team: any) => <TeamsCard team={team} />)}
    </div>
</div>

<style>
    /* Hele team-sektionen */
    .teams-wrapper {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Header med tekst + knap */
    .teams-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    /* Tekst */
    .teams-text {
        max-width: 650px;
    }

    /* Hovedoverskrift */
    .teams-text h1 {
        font-size: 1.8rem;
        font: var(--heading-lg);
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        color: var(--color-text);
    }

    /* Beskrivelse */
    .teams-text p:last-child {
        margin: 0;
        line-height: 1.6;
        font: var(--body-lg);
        color: var(--color-text-muted);
    }

    /* Join our team knap */
    .join-button {
        background-color: var(--color-blue-700);
        color: var(--color-on-surface-elevated);
        font-family: var(--button-sm);
        font-size: 1rem;
        font-weight: 400;
        letter-spacing: 0.5;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 1rem 1.75rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .join-button:hover {
        opacity: 0.85;
    }

    /* Grid med team cards */
    .teams-cards {
        display: grid;
        /* 3 cards på hver række */
        grid-template-columns: repeat(3, 1fr);
        /* Afstand mellem cards */
        gap: 2rem;
        width: 100%;
    }

    /* Tablet */
    @media (max-width: 900px) {
        .teams-header {
            align-items: flex-start;
        }

        .teams-cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Mobil */
    @media (max-width: 600px) {
        .teams-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .join-button {
            margin-top: 0.5rem;
        }

        .teams-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
