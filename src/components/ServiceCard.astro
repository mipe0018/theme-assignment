---
const { service } = Astro.props;

import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>

  <!-- <a> burde måske være en variant af en component -->
</article>

<style>
  @layer components {
    /* Den blå service-kasse */
    article {
      width: calc(100% - 2rem);
      margin-inline: auto;
      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);
      padding: 2rem;
      border-radius: 20px;
      display: flex;
      flex-direction: column;
    }

    h2 {
      font: var(--heading-sm);
      padding-bottom: 0.5rem;
    }

    p {
      line-height: 1.6;
      font: var(--body-lg);
      color: var(--color-on-surface-elevated);
      letter-spacing: 0.5;
      opacity: 0.9;
      padding-bottom: 2rem;
    }

    a {
      text-decoration: none;
      display: inline flex;
      gap: 1ch;
      color: var(--color-action);
      font-weight: bold;
      margin-top: auto;

      svg {
        inline-size: 16px;
      }
    }

    a:hover {
      text-decoration: underline;
    }
  }
</style>
