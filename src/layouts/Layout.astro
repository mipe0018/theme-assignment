---
// Importerer dit overordnede CSS-stylesheet
import "@styles/main.css";

// Importerer Font-funktionen fra Astro,
// så du kan hente og optimere skrifttyper
import { Font } from "astro:assets";

import Header from "@components/Header.astro";
import Newsletter from "@components/Newsletter.astro";
import Footer from "@components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>DIN TITEL HER. MÅSKE SOM PROP?</title>
    <!-- Indlæser skrifttypen Cabin og gemmer den som CSS-variablen --font-cabin -->
    <Font
      cssVariable="--font-cabin"
      preload
    />
    <!-- Indlæser skrifttypen Lato og gemmer den som CSS-variablen --font-lato -->
    <Font
      cssVariable="--font-lato"
      preload
    />
    <!-- Definerer rækkefølgen på dine CSS-layers -->
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    <Header />

    <main>
      <slot />
    </main>
    <Newsletter />
    <Footer />
  </body>
</html>

<style>
  body {
    display: grid;

    grid-template-columns:
      [a] 1fr
      [b] minmax(0, 1200px)
      [c] 1fr
      [d];

    grid-template-rows: auto 1fr auto;

    min-height: 100svh;

    margin: 0;
  }

  main {
    grid-column: a / d;
  }
</style>
